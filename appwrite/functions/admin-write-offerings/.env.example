# admin-write-offerings - Environment variables
# Configure in Appwrite Console -> Project -> Variables (global).

APPWRITE_ENDPOINT=https://appwrite.racoondevs.com/v1
APPWRITE_PROJECT_ID=69b37e1f001cce5d19cc
APPWRITE_DATABASE_ID=main

APPWRITE_COLLECTION_OFFERINGS_ID=offerings
APPWRITE_COLLECTION_SCHEDULE_EVENTS_ID=schedule_events
APPWRITE_COLLECTION_OFFERING_SLOTS_ID=offering_slots
APPWRITE_COLLECTION_LOCATION_PROFILES_ID=location_profiles
APPWRITE_COLLECTION_AVAILABILITY_BLOCKS_ID=availability_blocks
APPWRITE_COLLECTION_CONTENT_SECTIONS_ID=content_sections
APPWRITE_COLLECTION_BOOKINGS_ID=bookings

# Optional but required for availability rules / daily inventory operations
APPWRITE_COLLECTION_OFFERING_AVAILABILITY_RULES_ID=offering_availability_rules
APPWRITE_COLLECTION_OFFERING_DAILY_INVENTORY_ID=offering_daily_inventory

# Server secret - never expose in frontend env files
# Minimum scopes: users.read, databases.read, databases.write
APPWRITE_API_KEY=
